# ==============================================================================
# Portfolio Environment Configuration (.env.example)
# Copy to .env.local for local overrides. Configure in Netlify for production.
# ==============================================================================

# MongoDB Connection (Optional)
# If unconfigured, the application gracefully operates using in-memory seed caches
# for projects and an in-memory ring buffer for inbound contact transmissions.
MONGODB_URI=

# Resend Email Delivery Gateway (Optional)
# Dispatches real-time dark-mode HTML transmission emails directly to Abhimanyu's inbox.
# Powered by Resend REST API via native fetch() (zero extra npm packages required).
# Obtain a free API key at https://resend.com (Free tier: 3,000 emails/mo, 100 emails/day).
RESEND_API_KEY=
CONTACT_TO_EMAIL=akabhimanyukumar111@gmail.com
CONTACT_FROM_EMAIL=Portfolio Inbound <onboarding@resend.dev>

# Instant Mobile Alert Webhook (Optional)
# Dispatches instant rich push notifications to a Discord channel or Slack incoming webhook.
# Compatible with Discord webhooks (https://discord.com/api/webhooks/...) and standard Slack webhooks.
CONTACT_WEBHOOK_URL=
